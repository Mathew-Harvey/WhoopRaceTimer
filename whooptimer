#!/usr/bin/env sh
# WhoopTimer launcher — the local host and timer bridge.
#
# You only need this if your browser has no Web Bluetooth (Firefox, Safari), or
# you want to run the app on a phone or tablet over the track's wifi. On Chrome
# or Edge, just open https://whooptimer.webfpv.org instead.
#
# Never needs root: Bluetooth is the control transport, and the optional USB
# fallback only needs your user to be in the serial group.
#
#   ./whooptimer              serve on localhost only
#   ./whooptimer --lan        also reachable from a phone on the same network
#   ./whooptimer --port 9000  different port
set -eu
cd "$(dirname "$0")"

PY=""
for c in python3 python; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "Python 3 not found. Install it, then run: pip install -r requirements.txt" >&2
  exit 1
fi

if ! "$PY" -c "import bleak" >/dev/null 2>&1; then
  echo "Bluetooth support missing (bleak); this bridge can only offer USB."
  echo "  pip install -r requirements.txt"
  echo
fi

exec "$PY" server.py --open "$@"
